{
  "name": "vivi-resume",
  "version": "1.2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "pnpm generate-icons && vite",
    "start:prod": "pnpm generate-icons && vite --mode production",
    "generate-icons": "node scripts/generate-icon-bundle.cjs",
    "build": "pnpm generate-icons && vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "electron:dev": "pnpm generate-icons && concurrently -k -n vite,tsc,electron \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && node scripts/ensure-electron-pkg.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron --watch-path=dist-electron .\"",
    "electron:build": "pnpm generate-icons && vue-tsc && vite build && tsc -p tsconfig.electron.json && node scripts/ensure-electron-pkg.cjs && rimraf release && electron-builder --win"
  },
  "dependencies": {
    "@iconify-json/simple-icons": "^1.2.83",
    "@iconify/vue": "^5.0.1",
    "@tiptap/core": "^3.23.5",
    "@tiptap/extension-color": "^3.23.5",
    "@tiptap/extension-highlight": "^3.23.5",
    "@tiptap/extension-image": "^3.23.5",
    "@tiptap/extension-link": "^3.23.5",
    "@tiptap/extension-placeholder": "^3.23.5",
    "@tiptap/extension-task-item": "^3.23.5",
    "@tiptap/extension-task-list": "^3.23.5",
    "@tiptap/extension-text-align": "^3.23.5",
    "@tiptap/extension-text-style": "^3.23.5",
    "@tiptap/extension-underline": "^3.23.5",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@tiptap/vue-3": "^3.23.5",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^3.14.0",
    "lottie-web": "^5.13.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "modern-screenshot": "^4.7.0",
    "naive-ui": "^2.44.1",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^2.1.7",
    "turndown": "^7.2.4",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "^0.0.15",
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.3",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^25.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.71.1",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.4.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.6",
    "wait-on": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}